# Safe local/demo defaults. Production must explicitly configure real adapters.
IDENTITY_PROVIDER=mock
PROPERTY_PROVIDER=mock
SIGNING_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
DOCUMENT_STORAGE_PROVIDER=mock
SESSION_STORE=database

ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false
PROVIDER_TIMEOUT_MS=5000
PROVIDER_MAX_RETRIES=2
SESSION_COOKIE_NAME=aerc_session
SESSION_TTL_SECONDS=1800
# Generate a high-entropy secret for a real server session implementation.
SESSION_SECRET=

# Required by PostgreSQL runtime, migrations and seed scripts.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/aerc_surveys
