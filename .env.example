# Safe local/demo defaults. Production must explicitly configure real adapters.
APP_ENV=development
IDENTITY_PROVIDER=mock
PROPERTY_PROVIDER=mock
SIGNING_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
DOCUMENT_STORAGE_PROVIDER=database
SESSION_STORE=database
ENABLE_MOCK_AUTH=true

ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false
PROVIDER_TIMEOUT_MS=5000
PROVIDER_MAX_RETRIES=2
SESSION_COOKIE_NAME=aerc_session
SESSION_TTL_SECONDS=1800
# Raw session tokens exist only in HttpOnly cookies; PostgreSQL stores SHA-256 hashes.

# Required by PostgreSQL runtime, migrations and seed scripts.
# Local Docker maps 127.0.0.1:55432 -> container 5432. Do not point this at Supabase/Vercel.
# docker compose up -d
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/aerc_surveys
DATABASE_POOL_MAX=10

# Required guards for development fixtures. Never enable these in staging/production.
ALLOW_DEVELOPMENT_SEED=false
DEVELOPMENT_DATABASE_NAME=aerc_surveys
# Only set temporarily when intentionally running db:reset:development.
CONFIRM_DEVELOPMENT_RESET=

# Only set temporarily when bootstrapping a non-production Preview database (db:seed:preview).
# Rejected outright when APP_ENV=production. See docs/online-preview.md.
ALLOW_PREVIEW_SEED=false
